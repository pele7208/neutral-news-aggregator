# Runtime
DATABASE_URL=sqlite+aiosqlite:///./neutral_news.db
LOG_LEVEL=INFO

# Pipeline
PIPELINE_INTERVAL_MINUTES=30
CLUSTER_SIMILARITY_THRESHOLD=0.35
MAX_ARTICLES_PER_FETCH=50

# Summarization — leave blank to use free extractive summarization (default)
# Set OPENAI_API_KEY to enable GPT-based summarization.
# Set OLLAMA_URL to use a local Ollama model (e.g. http://localhost:11434).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=
OLLAMA_MODEL=llama3
